# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration
# You can leave this empty to use embedded in-memory MongoDB, or provide your Atlas/local MongoDB URI
MONGODB_URI=

# JWT Secrets
JWT_SECRET=cobalt_skies_jwt_secret_key_2026_super_secure_fest_platform
JWT_EXPIRE=7d

# Default Admin Credentials (Auto-created on seed)
ADMIN_EMAIL=admin@cobaltskies.com
ADMIN_PASSWORD=AdminPassword@2026

# Razorpay Payment Gateway (UPI & Cards)
# Get your test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
