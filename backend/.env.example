# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://cobalt-skies.pages.dev

# Database Configuration
# Leave blank to use zero-cost embedded in-memory MongoDB (no MongoDB Atlas or paid database required)
MONGODB_URI=

# JWT Secrets
JWT_SECRET=cobalt_skies_jwt_secret_key_2026_super_secure_fest_platform
JWT_EXPIRE=7d

# Default Admin Credentials (Auto-created on seed)
ADMIN_EMAIL=admin@cobaltskies.com
ADMIN_PASSWORD=AdminPassword@2026

# Razorpay Payment Gateway (Demo / Test Mode Enforced)
RAZORPAY_KEY_ID=rzp_test_DEMO_KEY
RAZORPAY_KEY_SECRET=demo_key_secret_not_used_in_test_mode
RAZORPAY_WEBHOOK_SECRET=demo_webhook_secret
RAZORPAY_TEST_MODE=true
